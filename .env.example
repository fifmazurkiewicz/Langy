# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend (Render / local) — SUPABASE_URL required on Render for JWKS (ES256); legacy HS256 optional:
# SUPABASE_JWT_SECRET=your-jwt-secret

# Local dev without Supabase: accept "dev-token" + unsigned JWTs. NEVER set this on Render.
# Ignored whenever SUPABASE_URL is set.
DEV_AUTH_ENABLED=false
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Redis not required for MVP (Postgres jobs). Optional later:
# REDIS_URL=redis://localhost:6379
SPEND_CAP_TZ=Europe/Warsaw
ALLOWED_ADMIN_EMAILS=fifmazurkiewicz@gmail.com

# Text / voice (docs/architecture-for-cursor.md §4)
TEXT_PROVIDER=openrouter
TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=your-openrouter-key

VOICE_MODE=speech_to_speech
# When VOICE_MODE=chained:
# STT_PROVIDER=groq
# TTS_PROVIDER=openai
GOOGLE_API_KEY=your-google-api-key

# Shadowing / tutor TTS — prefer elevenlabs (no browser voice in product UI)
TTS_PROVIDER=elevenlabs
# ElevenLabs voice ID, e.g. 21m00Tcm4TlvDq8ikWAM — see elevenlabs.io/voice-library
TTS_VOICE_ID=
# Optional browser voice substring, e.g. "Google UK English Female"
TTS_VOICE_NAME=
ELEVENLABS_API_KEY=

# Web Speech pause before commit in shadowing (ms). Phone bots use provider STT endpointing instead.
STT_END_SILENCE_MS=2500

# Langfuse Cloud — runtime prompt SoT + tracing
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# promptfoo — local/CI fixtures in repo
# PROMPTFOO_API_KEY=your-promptfoo-key

# Public URLs (prod) — frontend vars live in frontend/.env.example / Vercel dashboard
# NEXT_PUBLIC_API_URL=https://api-langy.fmazurkiewicz.dev
