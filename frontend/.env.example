# Backend API base URL (defaults to http://localhost:8000 when unset)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth. Leave BOTH empty for UI-only dev auth (frontend sends "dev-token";
# the backend then also needs DEV_AUTH_ENABLED=true and an empty SUPABASE_URL).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry: errors only; activate after privacy checks
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
# Next.js server/edge uses this same web project's DSN, not the API DSN.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Build-time secrets; never prefix the auth token with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=fmazurkiewicz
SENTRY_PROJECT=langy-web
