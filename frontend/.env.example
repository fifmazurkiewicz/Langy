# Backend API base URL (defaults to http://localhost:8000 when unset)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth. Leave BOTH empty for UI-only dev auth (frontend sends "dev-token";
# the backend then also needs DEV_AUTH_ENABLED=true and an empty SUPABASE_URL).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
